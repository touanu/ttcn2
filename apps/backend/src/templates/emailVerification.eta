<% layout("./partials/base") %>
<%
  include('./components/card', {
    content: `
      <mj-text font-size="24px" font-weight="700" align="center" css-class="dark-text">
        ${it.appName} – Email Verification
      </mj-text>

      ${include('./components/divider')}

      ${include('./components/dual-text', {
        viTitle: `Xin chào ${it.username},`,
        viText: `Vui lòng sử dụng mã OTP dưới đây để xác minh email.<br/><br/>OTP: <b>${it.otp}</b><br/>Hết hạn sau ${it.expiresInMinutes} phút.`,
        enTitle: `Hello ${it.username},`,
        enText: `Use the OTP below to verify your email.<br/><br/>OTP: <b>${it.otp}</b><br/>Expires in ${it.expiresInMinutes} minutes.`
      })}

      ${include('./components/button', {
        href: it.verifyUrl,
        text: "Verify Email"
      })}
    `
  });
%>
