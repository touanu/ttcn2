{
  "configurations": [
    {
      "command": "npm run dev:backend",
      "name": "Dev: Run Backend",
      "request": "launch",
      "type": "node-terminal",
      "preLaunchTask": "npm: install"
    },
    {
      "command": "npm run dev:frontend",
      "name": "Dev: Run Frontend",
      "request": "launch",
      "type": "node-terminal",
      "preLaunchTask": "npm: install"
    },
    {
      "name": "Launch Edge",
      "request": "launch",
      "type": "msedge",
      "url": "http://localhost:3333"
    },
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:3333"
    },
    {
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "name": "Launch Firefox",
      "url": "http://localhost:3333/"
    },
    {
      "type": "bun",
      "runtimeArgs": ["run", "dev:backend"],
      "request": "launch",
      "name": "Bun: Dev Backend",
      "cwd": "${workspaceFolder}",
      "program": "."
    },
    {
      "type": "bun",
      "runtimeArgs": ["run", "dev:frontend"],
      "request": "launch",
      "name": "Bun: Dev Frontend",
      "cwd": "${workspaceFolder}",
      "program": ".",
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Launch Firefox",
        "killOnServerStop": false
      }
    }
  ],
  "compounds": [
    {
      "name": "Development",
      "configurations": ["Dev: Run Backend", "Dev: Run Frontend"]
    },
    {
      "name": "Bun: Dev",
      "configurations": ["Bun: Dev Backend", "Bun: Dev Frontend"],
      "preLaunchTask": "npm: install"
    }
  ]
}
