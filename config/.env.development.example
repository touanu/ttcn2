# Dùng các tệp có suffix là .development để ghi đè biến môi trường
# trong môi trường dev

# LOGGING
LOG_DIR = /logs
LOG_LEVEL = debug

# SERVER URL
## Uncomment để ghi đè mặc định
## BE_URL = http://localhost:BE_PORT
## FE_URL = http://localhost:FE_PORT

# CORS
ORIGIN = http://localhost:3000
CREDENTIALS = true
CORS_ORIGINS = http://localhost:3000

# Database
DB_NAME = englearn
DB_HOST = localhost
DB_PORT = 27017

# Nodemailer
# Bật maildev để xem thư gửi đi, chỉ dùng trong môi trường dev
MAILDEV_ENABLED = true
MAILER_HOST = localhost
MAILER_PORT = 1025
